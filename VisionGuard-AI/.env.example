APP_NAME=VisionGuard AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
AUTH_SECRET_KEY=replace-with-a-unique-secret
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

STREAM_FRAME_WIDTH=640
STREAM_FRAME_HEIGHT=480
STREAM_TARGET_FPS=15
STREAM_JPEG_QUALITY=80
SNAPSHOT_STORAGE_DIR=storage/snapshots
SNAPSHOT_PUBLIC_PATH=/storage/snapshots

YOLO_MODEL_PATH=/ai_models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
DETECTION_STORAGE_DIR=storage/detections
DETECTION_PUBLIC_PATH=/storage/detections

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_USER=visionguard
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=visionguard_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://visionguard:replace-with-a-strong-database-password@db:5432/visionguard_ai
VITE_API_BASE_URL=http://localhost:8000/api/v1
